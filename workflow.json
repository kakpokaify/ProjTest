    {
      "parameters": {
        "jsCode": "const msg = $('Telegram Trigger').first().json?.message || {};\n\nlet type = 'unknown';\nif (msg.photo) type = 'photo';\nelse if (msg.document) type = 'document';\nelse if (msg.text) type = 'text';\n\nconst result = {\n  messageType: type\n};\n\nif (type === 'photo') {\n  result.isImage = true;\n  result.fileMime = 'image/jpeg';\n  result.fileName = 'photo_' + Date.now() + '.jpg';\n  result.fileId = msg.photo[msg.photo.length - 1]?.file_id;\n}\n\nif (type === 'document') {\n  const mime = msg.document?.mime_type || 'unknown';\n  result.fileMime = mime;\n  result.fileName = msg.document?.file_name || 'file';\n  result.isImage = /^image\\//.test(mime);\n  // FIX: also capture fileId for documents so downstream nodes\n  // don't need to re-access the raw message object.\n  result.fileId = msg.document?.file_id;\n}\n\nreturn [{ json: { ...$json, ...result } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
