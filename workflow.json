    {
      "parameters": {
        "jsCode": "// FIX: Get User Data returns a plain object, not an array.\n// The original code used .json[0] which is incorrect.\nconst userData = $('Get User Data').first().json || {};\nlet images = [];\n\n// Parse existing images from DB\nif (userData.Images) {\n  try {\n    images = typeof userData.Images === 'string'\n      ? JSON.parse(userData.Images)\n      : userData.Images;\n  } catch (e) {\n    console.error('Error parsing images:', e);\n    images = [];\n  }\n}\n\n// FIX: Use a timestamp-prefixed ID for better uniqueness guarantees\n// compared to bare Math.random(). Also replace deprecated substr with substring.\nconst newImage = {\n  id: Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 9),\n  fileName: $json?.fileName || 'photo.jpg',\n  fileId: $json?.fileId || null,\n  mimeType: $json?.fileMime || 'image/jpeg',\n  addedAt: new Date().toISOString()\n};\n\nimages.push(newImage);\n\nconsole.log('📸 Saved. Total in DB:', images.length);\n\n// Prepare for DB update\nreturn [{\n  json: {\n    userId: userData.Id,\n    images: images,\n    imagesJson: JSON.stringify(images),\n    success: true,\n    total: images.length,\n    isFirstImage: images.length === 1\n  }\n}];"
      },
