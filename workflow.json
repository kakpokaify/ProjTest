        "jsCode": "console.log('📋 Validating image:', $json);\n\nconst isImage = $json?.isImage === true;\n\nif (!isImage) {\n  console.error('❌ Not an image!');\n  return [];\n}\n\nconsole.log('✅ Image approved');\n\nreturn [{\n  json: {\n    ...$json,\n    validated: true,\n    validatedAt: new Date().toISOString()\n  }\n}];"
