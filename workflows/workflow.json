      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ chat_id: $json.chatId, text: '\\u2705 \\u0424\\u043e\\u0442\\u043e \\u0437\\u0430\\u0433\\u0440\\u0443\\u0436\\u0435\\u043d\\u044b (' + $json.totalPhotos + ' \\u0448\\u0442.). \\u041d\\u0430\\u0436\\u043c\\u0438\\u0442\\u0435 \\u043a\\u043d\\u043e\\u043f\\u043a\\u0443 \\u043d\\u0438\\u0436\\u0435, \\u0447\\u0442\\u043e\\u0431\\u044b \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442\\u044c \\u0442\\u0435\\u0433\\u0438.', reply_markup: { inline_keyboard: [[{ text: '\\ud83c\\udff7 \\u041d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0438\\u0442\\u044c \\u0442\\u0435\\u0433\\u0438', callback_data: 'start_tagging' }]] } }) }}",
        "options": {}
      },
      "id": "tg-send-collected",
      "name": "TG: Photos Collected",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        3100,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pipeline 3: Tagging Engine\nconst item=$input.first();\nconst{text,images,currentIndex,userState,rowId,chatId,messageId}=item.json;\nlet targetIndex=currentIndex;\nif(userState&&userState.startsWith('editing_')){\n  const x=parseInt(userState.split('_')[1],10);\n  if(!Number.isNaN(x)&&x>=0&&x<images.length)targetIndex=x;\n}\nconst updatedImages=images.map((img,idx)=>idx===targetIndex?{...img,tag:text}:img);\nlet newIndex=currentIndex,newState,nextFileId=null,nextPhotoNumber=null;\nif(userState&&userState.startsWith('editing_')){\n  newState='review';\n}else{\n  newIndex=currentIndex+1;\n  if(newIndex<updatedImages.length){\n    newState='tagging';nextFileId=updatedImages[newIndex].file_id;nextPhotoNumber=newIndex+1;\n  }else{newState='review';}\n}\nconst nocoBody={state:newState,images:JSON.stringify(updatedImages),current_index:newIndex};\nreturn [{json:{...item.json,updatedImages,newIndex,newState,nextFileId,nextPhotoNumber,nocoBody,rowId}}];"
      },
      "id": "code-tagging",
      "name": "Pipeline 3: Tagging Engine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.NOCODB_BASE_URL }}/api/v1/db/data/noco/{{ $env.NOCODB_PROJECT_ID }}/users/{{ $json.rowId }}",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify($json.nocoBody) }}",
