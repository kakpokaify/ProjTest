      "parameters": {
        "jsCode": "// Pipeline 0: Extract Telegram ID for auth\nconst item = $input.first();\nconst body = item.json.body ?? item.json;\nlet chatId = null, userId = null;\nif (body.message) { chatId = body.message.chat.id; userId = String(body.message.from.id); }\nelse if (body.callback_query) { chatId = body.callback_query.message.chat.id; userId = String(body.callback_query.from.id); }\nif (!userId) return [{ json: { skip: true, reason: 'no_user_id' } }];\nreturn [{ json: { ...item.json, chatId, userId } }];"
      },
