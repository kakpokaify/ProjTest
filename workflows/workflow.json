    {
      "parameters": {
        "jsCode": "// Pipeline 0: Authorization Check\n// Access granted if: Priority === true OR Status === 'Admin' OR Status === 'Free unlimited access'\nconst item = $input.first();\nconst nocoResp = item.json;\nconst userRecord = (nocoResp.list && nocoResp.list.length > 0) ? nocoResp.list[0] : null;\nlet authorized = false;\nif (userRecord) {\n  const priority = userRecord['Priority'];\n  const status   = userRecord['Status'] ?? '';\n  authorized = (priority === true || priority === 'true')\n    || status === 'Admin'\n    || status === 'Free unlimited access';\n}\nlet chatId = null;\ntry { chatId = $('Extract Telegram Data').first().json.chatId; } catch (_) {}\nconst denialBody = {\n  chat_id: chatId,\n  text: '⛔ У вас нет доступа к этому боту. Обратитесь к администратору.',\n};\nreturn [{ json: { authorized, userRecord, chatId, denialBody } }];"
      },
