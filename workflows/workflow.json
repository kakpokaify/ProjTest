    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/editMessageMedia",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ chat_id: $json.chatId, message_id: $json.messageId, media: { type: 'photo', media: $json.nextFileId, caption: 'Assign tag for photo #' + $json.nextPhotoNumber }, reply_markup: { inline_keyboard: [[ ...(($json.newIndex > 0) ? [{ text: '< Back', callback_data: 'back' }] : []), { text: 'X Cancel', callback_data: 'cancel' } ]] } }) }}",
        "options": {}
      },
      "id": "tg-edit-media-next",
      "name": "TG: Next Photo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        3100,
        240
