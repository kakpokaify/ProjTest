    {
      "parameters": {
        "jsCode": "// Pipeline 1: State Merge\nconst routerData = $('Pipeline 1: Router').first().json;\nlet dbUser={};\ntry {\n  const nocoResp=$('NocoDB Find User').first().json;\n  if(nocoResp.list&&nocoResp.list.length>0){dbUser=nocoResp.list[0];}\n  else{dbUser=$('NocoDB Create User').first().json;}\n} catch(_){}\nconst userState=dbUser.state??'empty';\nconst currentIndex=dbUser.current_index??0;\nconst rowId=dbUser.Id??null;\nconst images=(()=>{\n  const raw=dbUser.images;\n  if(!raw)return[];\n  if(typeof raw==='string'){try{return JSON.parse(raw);}catch(_){return[];}}\n  return Array.isArray(raw)?raw:[];\n})();\nconst {updateType}=routerData;\nlet routeKey;\nif(updateType==='callback_query'){routeKey='pipeline4';}\nelse if(updateType==='photo'&&(userState==='empty'||userState==='collecting')){routeKey='pipeline2';}\nelse if(updateType==='text'&&(userState==='tagging'||userState.startsWith('editing_'))){routeKey='pipeline3';}\nelse{routeKey='unknown';}\nreturn [{json:{...routerData,userState,currentIndex,images,rowId,routeKey}}];"
      },
      "id": "code-state-merge",
      "name": "Pipeline 1: State Merge",
      "type": "n8n-nodes-base.code",
