    {
      "parameters": {
        "jsCode": "// Build Review Report\nconst item=$input.first();\nconst images=Array.isArray(item.json.updatedImages)?item.json.updatedImages:(Array.isArray(item.json.images)?item.json.images:[]);\nconst lines=images.map((img,i)=>`Image ${i+1} - ${img.tag??'(no tag)'}`);\nconst reviewText=lines.join('\\n');\nconst editButtons=images.map((img,i)=>[{text:`Edit photo ${i+1}`,callback_data:`edit_${i}`}]);\neditButtons.push([{text:'Done',callback_data:'done'}]);\nconst reviewKeyboard={inline_keyboard:editButtons};\nreturn [{json:{...item.json,reviewText,reviewKeyboard}}];"
      },
      "id": "code-review-report",
      "name": "Build Review Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3100,
        360
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ chat_id: $json.chatId, text: $json.reviewText, reply_markup: $json.reviewKeyboard }) }}",
        "options": {}
      },
      "id": "tg-send-review",
      "name": "TG: Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        3320,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pipeline 4: Callback Handler\nconst item=$input.first();\nconst{callbackData,callbackQueryId,chatId,messageId,images,currentIndex,rowId}=item.json;\nlet nocoBody=null,tgAction=null,tgBody=null,routeKey='noop',newIndex=currentIndex;\nfunction tagKb(idx){\n  const b=[];\n  if(idx>0)b.push({text:'< Back',callback_data:'back'});\n  b.push({text:'X Cancel',callback_data:'cancel'});\n  return{inline_keyboard:[b]};\n}\nif(callbackData==='cancel'){\n  nocoBody={state:'empty',images:JSON.stringify([]),current_index:0};\n  tgAction='deleteMessage';tgBody={chat_id:chatId,message_id:messageId};routeKey='cancel';\n}else if(callbackData==='back'){\n  newIndex=Math.max(0,currentIndex-1);\n  nocoBody={state:'tagging',current_index:newIndex};\n  tgAction='editMessageMedia';\n  tgBody={chat_id:chatId,message_id:messageId,media:{type:'photo',media:images[newIndex]?.file_id??'',caption:`Assign tag for photo #${newIndex+1}`},reply_markup:tagKb(newIndex)};\n  routeKey='back';\n}else if(callbackData==='start_tagging'){\n  newIndex=0;nocoBody={state:'tagging',current_index:0};tgAction='sendPhoto';\n  tgBody={chat_id:chatId,photo:images[0]?.file_id??'',caption:'Assign tag for photo #1',reply_markup:tagKb(0)};routeKey='start_tagging';\n}else if(callbackData==='done'){\n  nocoBody={state:'empty',images:JSON.stringify([]),current_index:0};\n  tgAction='answerCallbackQuery';tgBody={callback_query_id:callbackQueryId,text:'Tags saved!'};routeKey='done';\n}else if(callbackData&&callbackData.startsWith('edit_')){\n  const x=parseInt(callbackData.split('_')[1],10);\n  if(!Number.isNaN(x)&&x>=0&&x<images.length){\n    nocoBody={state:`editing_${x}`,current_index:x};tgAction='editMessageMedia';\n    tgBody={chat_id:chatId,message_id:messageId,media:{type:'photo',media:images[x].file_id,caption:`Enter new tag for photo #${x+1}`},reply_markup:tagKb(x)};\n    routeKey='edit';\n  }\n}else if(callbackData==='show_review'){routeKey='show_review';}\nconst answerCbBody={callback_query_id:callbackQueryId};\nreturn [{json:{...item.json,nocoBody,tgAction,tgBody,answerCbBody,routeKey,newIndex}}];"
      },
      "id": "code-callback",
      "name": "Pipeline 4: Callback Handler",
      "type": "n8n-nodes-base.code",
