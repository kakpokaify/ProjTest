    {
      "parameters": {
        "jsCode": "// Pipeline 2: Aggregate photos\nconst items=$input.all();\nconst seenIds=new Set(),newPhotos=[];\nfor(const it of items){\n  const fid=it.json.fileId;\n  if(fid&&!seenIds.has(fid)){seenIds.add(fid);newPhotos.push({file_id:fid,tag:null});}\n}\nconst base=items[0].json;\nconst existing=Array.isArray(base.images)?base.images:[];\nconst existingIds=new Set(existing.map(p=>p.file_id));\nconst toAdd=newPhotos.filter(p=>!existingIds.has(p.file_id));\nconst mergedImages=[...existing,...toAdd].slice(0,8);\nreturn [{json:{...base,mergedImages,totalPhotos:mergedImages.length}}];"
      },
      "id": "code-aggregate",
      "name": "Pipeline 2: Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        180
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.NOCODB_BASE_URL }}/api/v1/db/data/noco/{{ $env.NOCODB_PROJECT_ID }}/users/{{ $json.rowId }}",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ state: 'collecting', images: JSON.stringify($json.mergedImages), current_index: 0 }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "nocodb-patch-p2",
      "name": "NocoDB PATCH – Collecting",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2880,
